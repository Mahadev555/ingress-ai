# Copy to .env and fill in your values.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (AI Studio)
GEMINI_API_KEY=...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Models advertised by GET /v1/models (comma-separated). Add or remove freely;
# any model matching a registry prefix still routes even if not listed here.
AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,claude-3-5-sonnet,claude-3-5-haiku,gemini-1.5-flash,gemini-1.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-3.1-flash-lite

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# Azure OpenAI (address models as "azure/<deployment-name>")
AZURE_API_KEY=...
AZURE_ENDPOINT=https://your-resource.openai.azure.com
AZURE_API_VERSION=2024-02-15-preview

# OpenAI-compatible providers — same wire format, just a different base URL + key.
# Set a key (and register the model with the matching provider) to use it. Base
# URLs default to each provider's public endpoint; override only if needed.
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.xyz/v1
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama runs locally and ignores the key, but a value marks it "configured".
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Database — SQLite by default for local dev; use Postgres anywhere:
# DATABASE_URL=postgresql+asyncpg://ingress:ingress@localhost:5432/ingress_ai
DATABASE_URL=sqlite+aiosqlite:///./ingress.db

# Admin API for virtual-key management (sent as the X-Admin-Token header).
# Leave empty to disable the admin endpoints entirely.
ADMIN_API_KEY=
# Extra full-admin tokens (comma-separated), and read-only tokens that can hit
# GET admin endpoints but not create/edit/delete.
ADMIN_TOKENS=
ADMIN_READ_TOKENS=

# Passphrase (any string) used to encrypt provider credential keys at rest.
# Leave empty for local dev (keys stored as plaintext); set a strong value in
# production. Changing it makes existing encrypted keys unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# MCP gateway: expose POST /mcp, one governed MCP endpoint fronting many upstream
# MCP servers (registered via /admin/mcp/servers) and reusing virtual keys +
# the usage ledger. Off by default; the endpoint 404s-in-effect until enabled.
MCP_ENABLED=false
MCP_TOOL_TIMEOUT=30            # upstream MCP tool-call timeout (seconds)

# Rate limiting (token bucket, per key + model). Per-key rate_limit_per_minute
# and tpm_limit override these defaults.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# "memory" for a single instance / local dev, "redis" for multi-replica prod
RATE_LIMIT_BACKEND=memory

# Cost tracking: estimate/store per-request USD cost (from model registry prices)
# and enforce cost budgets. Set false for a token-only gateway that leaves dollar
# accounting to the provider invoice — the dashboard then hides all cost columns.
COST_TRACKING_ENABLED=true

# Audit: capture redacted prompt/response text to the audit_logs table.
AUDIT_CAPTURE_CONTENT=true

# Playground conversation turn limit (client-side hint, exposed at GET /v1/config).
# The gateway itself never caps conversation length.
MAX_CONVERSATION_TURNS=5

# Guardrails
MAX_REQUEST_BYTES=1000000       # reject request bodies larger than this (413)
MAX_OUTPUT_TOKENS_CAP=0         # clamp requested max_tokens (0 = no cap)
GUARDRAILS_ENABLED=false        # simple prompt-injection screening

# Load balancing across a model's deployments (see /admin/deployments).
# "simple-shuffle" (weighted random) | "least-busy" | "latency"
ROUTING_STRATEGY=simple-shuffle

# Budget alerts: POST a Slack-compatible {"text": ...} to this webhook when a key
# or team crosses a budget threshold. Empty disables alerting.
ALERT_WEBHOOK_URL=
ALERT_SOFT_THRESHOLD=0.8         # warn at this fraction of budget before the hard cap

# Resilience: retry (per candidate) + circuit breaker (per provider)
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=0.05
RETRY_MAX_DELAY=2.0
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30

# Exact-match response cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
# "memory" for a single instance / local dev, "redis" for multi-replica prod
CACHE_BACKEND=memory

# Redis (used by the "redis" rate-limit backend and later build days)
REDIS_URL=redis://localhost:6379/0

# Upstream HTTP timeout (seconds)
REQUEST_TIMEOUT=60
