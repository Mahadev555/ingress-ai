# Copy to .env and fill in your values.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (AI Studio)
GEMINI_API_KEY=...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Models advertised by GET /v1/models (comma-separated). Add or remove freely;
# any model matching a registry prefix still routes even if not listed here.
AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,claude-3-5-sonnet,claude-3-5-haiku,gemini-1.5-flash,gemini-1.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-3.1-flash-lite

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# Azure OpenAI (address models as "azure/<deployment-name>")
AZURE_API_KEY=...
AZURE_ENDPOINT=https://your-resource.openai.azure.com
AZURE_API_VERSION=2024-02-15-preview

# Database — SQLite by default for local dev; use Postgres anywhere:
# DATABASE_URL=postgresql+asyncpg://ingress:ingress@localhost:5432/ingress_ai
DATABASE_URL=sqlite+aiosqlite:///./ingress.db

# Admin API for virtual-key management (sent as the X-Admin-Token header).
# Leave empty to disable the admin endpoints entirely.
ADMIN_API_KEY=

# Rate limiting (token bucket, per key + model)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# "memory" for a single instance / local dev, "redis" for multi-replica prod
RATE_LIMIT_BACKEND=memory

# Resilience: retry (per candidate) + circuit breaker (per provider)
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=0.05
RETRY_MAX_DELAY=2.0
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30

# Exact-match response cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
# "memory" for a single instance / local dev, "redis" for multi-replica prod
CACHE_BACKEND=memory

# Redis (used by the "redis" rate-limit backend and later build days)
REDIS_URL=redis://localhost:6379/0

# Upstream HTTP timeout (seconds)
REQUEST_TIMEOUT=60
